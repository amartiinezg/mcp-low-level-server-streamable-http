# ─── Modo LOCAL_SAP_DIRECT (sin BTP) ─────────────────────────────────────
# Activa para llamar a SAP directo desde la red corporativa (VPN Convista).
LOCAL_SAP_DIRECT=true

# URL base SAP OnPremise (host:puerto, sin /sap/opu/...)
LOCAL_SAP_URL=https://saps373.sap.convista.local:44300

# Credenciales SAP (rellena con las tuyas)
LOCAL_SAP_USER=TU_USUARIO_SAP
LOCAL_SAP_PASSWORD=TU_PASSWORD_SAP

# Mandante
LOCAL_SAP_CLIENT=101

# CA bundle Convista. Si lo dejas comentado, se auto-detecta en ./certs/ o ../certs/
# SAP_CA_BUNDLE=./certs/convista-ca-bundle.pem

# ─── MCP server ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CAP service ─────────────────────────────────────────────────────────
CAP_SERVICE_URL=http://localhost:4004

# ─── IAS / OAuth (desactivado en local) ──────────────────────────────────
IAS_ENABLED=false

# ─── BTP (no se usa con LOCAL_SAP_DIRECT) ────────────────────────────────
# BTP_DESTINATION_SERVICE_URL=
# BTP_DESTINATION_CLIENT_ID=
# BTP_DESTINATION_CLIENT_SECRET=
# BTP_DESTINATION_TOKEN_URL=
# BTP_DESTINATION_NAME=
