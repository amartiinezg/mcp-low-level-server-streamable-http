<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="CatalogService" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <Annotation Term="Core.Links">
        <Collection>
          <Record>
            <PropertyValue Property="rel" String="author"/>
            <PropertyValue Property="href" String="https://cap.cloud.sap"/>
          </Record>
        </Collection>
      </Annotation>
      <EntityContainer Name="EntityContainer">
        <EntitySet Name="Products" EntityType="CatalogService.Products"/>
        <EntitySet Name="Orders" EntityType="CatalogService.Orders">
          <NavigationPropertyBinding Path="items" Target="OrderItems"/>
        </EntitySet>
        <EntitySet Name="OrderItems" EntityType="CatalogService.OrderItems">
          <NavigationPropertyBinding Path="order" Target="Orders"/>
          <NavigationPropertyBinding Path="product" Target="Products"/>
        </EntitySet>
        <EntitySet Name="Customers" EntityType="CatalogService.Customers"/>
        <ActionImport Name="createCompleteOrder" Action="CatalogService.createCompleteOrder"/>
        <FunctionImport Name="getLowStockProducts" Function="CatalogService.getLowStockProducts" EntitySet="Products"/>
        <ActionImport Name="updateOrderStatus" Action="CatalogService.updateOrderStatus" EntitySet="Orders"/>
      </EntityContainer>
      <EntityType Name="Products">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="name" Type="Edm.String" MaxLength="100"/>
        <Property Name="description" Type="Edm.String" MaxLength="500"/>
        <Property Name="price" Type="Edm.Decimal" Precision="10" Scale="2"/>
        <Property Name="stock" Type="Edm.Int32"/>
        <Property Name="category" Type="Edm.String" MaxLength="50"/>
        <Property Name="active" Type="Edm.Boolean" DefaultValue="true"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="modifiedAt" Type="Edm.DateTimeOffset" Precision="7"/>
      </EntityType>
      <EntityType Name="Orders">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="orderNumber" Type="Edm.String" MaxLength="20"/>
        <Property Name="customerName" Type="Edm.String" MaxLength="100"/>
        <Property Name="totalAmount" Type="Edm.Decimal" Precision="10" Scale="2"/>
        <Property Name="status" Type="Edm.String" MaxLength="20" DefaultValue="PENDING"/>
        <Property Name="orderDate" Type="Edm.DateTimeOffset"/>
        <NavigationProperty Name="items" Type="Collection(CatalogService.OrderItems)" Partner="order">
          <OnDelete Action="Cascade"/>
        </NavigationProperty>
      </EntityType>
      <EntityType Name="OrderItems">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <NavigationProperty Name="order" Type="CatalogService.Orders" Partner="items">
          <ReferentialConstraint Property="order_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="order_ID" Type="Edm.Guid"/>
        <NavigationProperty Name="product" Type="CatalogService.Products">
          <ReferentialConstraint Property="product_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="product_ID" Type="Edm.Guid"/>
        <Property Name="quantity" Type="Edm.Int32"/>
        <Property Name="unitPrice" Type="Edm.Decimal" Precision="10" Scale="2"/>
        <Property Name="subtotal" Type="Edm.Decimal" Precision="10" Scale="2"/>
      </EntityType>
      <EntityType Name="Customers">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="name" Type="Edm.String" MaxLength="100"/>
        <Property Name="email" Type="Edm.String" MaxLength="100"/>
        <Property Name="phone" Type="Edm.String" MaxLength="20"/>
        <Property Name="address" Type="Edm.String" MaxLength="200"/>
        <Property Name="active" Type="Edm.Boolean" DefaultValue="true"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
      </EntityType>
      <ComplexType Name="return_CatalogService_createCompleteOrder">
        <Property Name="orderId" Type="Edm.Guid"/>
        <Property Name="orderNumber" Type="Edm.String"/>
        <Property Name="totalAmount" Type="Edm.Decimal" Scale="variable"/>
      </ComplexType>
      <ComplexType Name="ap_CatalogService_createCompleteOrder_items">
        <Property Name="productId" Type="Edm.Guid"/>
        <Property Name="quantity" Type="Edm.Int32"/>
      </ComplexType>
      <Action Name="createCompleteOrder" IsBound="false">
        <Parameter Name="customerName" Type="Edm.String"/>
        <Parameter Name="items" Type="Collection(CatalogService.ap_CatalogService_createCompleteOrder_items)" Nullable="true"/>
        <ReturnType Type="CatalogService.return_CatalogService_createCompleteOrder"/>
      </Action>
      <Function Name="getLowStockProducts" IsBound="false" IsComposable="false">
        <Parameter Name="threshold" Type="Edm.Int32"/>
        <ReturnType Type="Collection(CatalogService.Products)"/>
      </Function>
      <Action Name="updateOrderStatus" IsBound="false">
        <Parameter Name="orderId" Type="Edm.Guid"/>
        <Parameter Name="newStatus" Type="Edm.String"/>
        <ReturnType Type="CatalogService.Orders"/>
      </Action>
      <Annotations Target="CatalogService.Products/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="CatalogService.Products/name">
        <Annotation Term="Common.Label" String="Nombre del Producto"/>
      </Annotations>
      <Annotations Target="CatalogService.Products/description">
        <Annotation Term="Common.Label" String="Descripción"/>
      </Annotations>
      <Annotations Target="CatalogService.Products/price">
        <Annotation Term="Common.Label" String="Precio"/>
      </Annotations>
      <Annotations Target="CatalogService.Products/stock">
        <Annotation Term="Common.Label" String="Stock Disponible"/>
      </Annotations>
      <Annotations Target="CatalogService.Products/category">
        <Annotation Term="Common.Label" String="Categoría"/>
      </Annotations>
      <Annotations Target="CatalogService.Products/active">
        <Annotation Term="Common.Label" String="Activo"/>
      </Annotations>
      <Annotations Target="CatalogService.Products/createdAt">
        <Annotation Term="Core.Computed" Bool="true"/>
      </Annotations>
      <Annotations Target="CatalogService.Products/modifiedAt">
        <Annotation Term="Core.Computed" Bool="true"/>
      </Annotations>
      <Annotations Target="CatalogService.Orders/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="CatalogService.Orders/orderNumber">
        <Annotation Term="Common.Label" String="Número de Orden"/>
      </Annotations>
      <Annotations Target="CatalogService.Orders/customerName">
        <Annotation Term="Common.Label" String="Nombre del Cliente"/>
      </Annotations>
      <Annotations Target="CatalogService.Orders/totalAmount">
        <Annotation Term="Common.Label" String="Monto Total"/>
      </Annotations>
      <Annotations Target="CatalogService.Orders/status">
        <Annotation Term="Common.Label" String="Estado"/>
      </Annotations>
      <Annotations Target="CatalogService.Orders/orderDate">
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="Fecha de Orden"/>
      </Annotations>
      <Annotations Target="CatalogService.OrderItems/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="CatalogService.OrderItems/quantity">
        <Annotation Term="Common.Label" String="Cantidad"/>
      </Annotations>
      <Annotations Target="CatalogService.OrderItems/unitPrice">
        <Annotation Term="Common.Label" String="Precio Unitario"/>
      </Annotations>
      <Annotations Target="CatalogService.OrderItems/subtotal">
        <Annotation Term="Common.Label" String="Subtotal"/>
      </Annotations>
      <Annotations Target="CatalogService.Customers/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="CatalogService.Customers/name">
        <Annotation Term="Common.Label" String="Nombre"/>
      </Annotations>
      <Annotations Target="CatalogService.Customers/email">
        <Annotation Term="Common.Label" String="Email"/>
      </Annotations>
      <Annotations Target="CatalogService.Customers/phone">
        <Annotation Term="Common.Label" String="Teléfono"/>
      </Annotations>
      <Annotations Target="CatalogService.Customers/address">
        <Annotation Term="Common.Label" String="Dirección"/>
      </Annotations>
      <Annotations Target="CatalogService.Customers/active">
        <Annotation Term="Common.Label" String="Activo"/>
      </Annotations>
      <Annotations Target="CatalogService.Customers/createdAt">
        <Annotation Term="Core.Computed" Bool="true"/>
      </Annotations>
      <Annotations Target="CatalogService.getLowStockProducts(Edm.Int32)/threshold">
        <Annotation Term="Core.OptionalParameter">
          <Record Type="Core.OptionalParameterType"/>
        </Annotation>
      </Annotations>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>